# Copy to .env and fill in. .env is never committed — it lives on the box
# only. This file (.env.example) is the committed placeholder.

# Used as the container name, and as the restic tag for backup/restore.
# Keep it stable once you've taken a first backup — changing it orphans
# old snapshots under the old tag.
GAME_NAME=zomboid

# Always a real pinned tag, tracking the game's own build number for this
# image — never "latest". Build 42 is the current stable branch; check
# https://hub.docker.com/r/danixu86/project-zomboid-dedicated-server/tags
# for newer *-release tags before deploying.
IMAGE_TAG=42.20.2-release

# Host ports. Must be unique across every game on this box.
# Register them in ../../PORTS.md before you pick them.
# Zomboid needs all five — see games/zomboid/README.md for what each is for.
GAME_PORT=16261
DIRECT_PORT=16262
STEAM_PORT1=8766
STEAM_PORT2=8767
RCON_PORT=27015

# Bind mount, not a named volume. Matches infra-base's games_root layout.
# This is the *only* directory the image persists to — saves, server .ini,
# RCON password, logs all live under here.
DATA_DIR=/srv/games/zomboid/data

# Required on first boot only — the server refuses to start without it once.
# The image logs every launch argument in clear text, so once the server
# has come up successfully at least once, blank this out in the real .env
# on the box (existing admin accounts aren't affected).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# RCON is how the future API/bot (see ../../API.md) and any manual admin
# tooling will talk to this server. Keep RCON_PORT firewalled to admin IPs
# only in infra-base — never expose 27015 to 0.0.0.0/the public internet.
RCON_PASSWORD=changeme_rcon

# Shown in the in-game server browser.
SERVER_NAME=My Zomboid Server

# Leave blank for no join password.
SERVER_PASSWORD=

# List this server in the public in-game server browser.
PUBLIC=false

# JVM heap size. Size for the box this runs on, not a guess — Zomboid is
# memory-hungry with mods. 4096m is a reasonable default for a small
# vanilla/lightly-modded server.
MEMORY=4096m

# Semicolon-separated Workshop mod IDs and their matching Mod IDs. Leave
# both blank to run vanilla. See README.md — mods need two server restarts
# after the first to fully register, three if they add maps.
MOD_IDS=
WORKSHOP_IDS=
