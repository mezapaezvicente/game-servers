# Copy to .env and fill in. .env is never committed — it lives on the box
# only. This file (.env.example) is the committed placeholder.

# Used as the container name, and as the restic tag for backup/restore.
# Keep it stable once you've taken a first backup — changing it orphans
# old snapshots under the old tag.
GAME_NAME=example-game

# Always a real pinned tag. Never "latest".
IMAGE_TAG=1.0.0

# Host port. Must be unique across every game on this box.
# Register it in ../../PORTS.md before you pick one.
GAME_PORT=27015

# Bind mount, not a named volume. Matches infra-base's games_root layout.
DATA_DIR=/srv/games/example-game/data
